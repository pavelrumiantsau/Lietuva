---
pagination:
  data: locales
  size: 1
  alias: lang
permalink: "{{ lang | homeUrl }}"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ 'nav.home' | t(lang) }}"
  altUrlLt: "{{ 'lt' | homeUrl }}"
  altUrlEn: "{{ 'en' | homeUrl }}"
  altUrlUk: "{{ 'uk' | homeUrl }}"
pageScripts:
  - url: https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js
    integrity: sha384-cxOPjt7s7Iz04uaHJceBmS+qpjv2JkIHNVcuOrM+YHwZOmJGBXI00mdUXEq65HTH
  - url: https://cdn.jsdelivr.net/npm/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js
    integrity: sha384-eXVCORTRlv4FUUgS/xmOyr66XBVraen8ATNLMESp92FKXLAMiKkerixTiBvXriZr
  - /assets/js/map.js
pageStyles:
  - url: https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css
    integrity: sha384-sHL9NAb7lN7rfvG5lfHpm643Xkcjzp4jFvuavGOndn6pjVqS6ny56CAt3nsEVT4H
  - url: https://cdn.jsdelivr.net/npm/leaflet.markercluster@1.5.3/dist/MarkerCluster.css
    integrity: sha384-pmjIAcz2bAn0xukfxADbZIb3t8oRT9Sv0rvO+BR5Csr6Dhqq+nZs59P0pPKQJkEV
  - url: https://cdn.jsdelivr.net/npm/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css
    integrity: sha384-wgw+aLYNQ7dlhK47ZPK7FRACiq7ROZwgFNg0m04avm4CaXS+Z9Y7nMu8yNjBKYC+
---
<section class="hero">
  <h1>{{ "site.title" | t(lang) }}</h1>
  <p>{{ "home.intro" | t(lang) }}</p>
  <a class="browse-all-link" href="{{ lang | listUrl }}">{{ "home.browseAll" | t(lang) }}</a>
</section>

<div id="map" role="application" aria-label="{{ 'nav.map' | t(lang) }}"></div>
<p class="map-note">{{ "home.mapUnavailable" | t(lang) }}</p>

<script type="application/json" id="places-data">{{ places | mapData(lang) | json | safe }}</script>
<script>
  window.SITE_LANG = {{ lang | json | safe }};
  window.SITE_STRINGS = { explore: {{ "place.explore" | t(lang) | json | safe }} };
</script>
