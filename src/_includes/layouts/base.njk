<!doctype html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} — {{ "site.title" | t(lang) }}</title>
  <meta name="description" content="{{ "site.tagline" | t(lang) }}">
  {% if pageStyles %}
    {% for style in pageStyles %}
    {% if style.url %}
    <link rel="stylesheet" href="{{ style.url }}" integrity="{{ style.integrity }}" crossorigin="anonymous">
    {% else %}
    <link rel="stylesheet" href="{{ style }}">
    {% endif %}
    {% endfor %}
  {% endif %}
  <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>
  <script>window.SITE_PATH_PREFIX = {{ '/' | url | json | safe }};</script>
  <a class="skip-link" href="#main">{{ "nav.home" | t(lang) }} — skip to content</a>

  <header class="site-header">
    <div class="site-header__inner">
      <a class="site-title" href="{{ lang | homeUrl }}">{{ "site.title" | t(lang) }}</a>

      <nav class="site-nav" aria-label="{{ 'nav.home' | t(lang) }}">
        <a href="{{ lang | homeUrl }}">{{ "nav.map" | t(lang) }}</a>
        <a href="{{ lang | listUrl }}">{{ "nav.places" | t(lang) }}</a>
      </nav>

      <nav class="lang-switch" aria-label="{{ 'langSwitch.label' | t(lang) }}">
        {% set altUrls = {"lt": altUrlLt, "en": altUrlEn, "uk": altUrlUk} %}
        {% for l in locales %}
          <a href="{{ altUrls[l] }}"{% if l == lang %} aria-current="true" class="is-current"{% endif %}>{{ l | langLabel }}</a>
        {% endfor %}
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <p>{{ "footer.text" | t(lang) }}</p>
  </footer>

  {% if pageScripts %}
    {% for script in pageScripts %}
    {% if script.url %}
    <script src="{{ script.url }}" integrity="{{ script.integrity }}" crossorigin="anonymous"></script>
    {% else %}
    <script src="{{ script }}"></script>
    {% endif %}
    {% endfor %}
  {% endif %}
</body>
</html>
